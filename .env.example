# AI review (LLM) — used by scripts/ai-review.js in pre-push hook
#
# Copy to .env.local (recommended) and fill values.
# Note: .env.local is ignored by git.

# Required to enable real AI review
OPENAI_API_KEY=

# Optional: model and endpoint (OpenAI-compatible)
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: limits to keep requests small (chars / counts)
AI_REVIEW_MAX_FILES=12
AI_REVIEW_MAX_FILE_CHARS=40000
AI_REVIEW_MAX_DIFF_CHARS=120000

