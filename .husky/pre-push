#!/usr/bin/env sh
echo "🤖 Запуск AI-ревью перед пушем..."

# Запускаем AI-ревью измененных компонентов
yarn ai-review

# Проверяем, был ли создан отчет
if [ -f "AI_REVIEW.md" ]; then
  echo "📄 Отчет AI-ревью сохранен в: AI_REVIEW.md"
  
  # Показываем краткую сводку
  echo ""
  echo "📊 Краткая сводка из отчета:"
  echo "----------------------------"
  
  # Извлекаем основные метрики из отчета
  if command -v grep > /dev/null 2>&1; then
    grep -E "(Проанализировано файлов:|Обнаружено проблем:|Предупреждений:|Рекомендаций:)" AI_REVIEW.md | head -4
  else
    # Для Windows без grep
    echo "Для полного отчета откройте файл AI_REVIEW.md"
  fi
  
  echo ""
  echo "💡 Рекомендуется проверить отчет перед пушем:"
  echo "  cat AI_REVIEW.md"
  echo ""
  
  # Не блокируем пуш, только информируем
  echo "⚠️  AI-ревью завершено. Пуш не заблокирован."
  echo "   Для блокировки пуша при критических проблемах раскомментируйте exit 1 ниже."
  
  # Если хотим блокировать пуш при критических проблемах, раскомментируйте:
  # if grep -q "❌ Критические проблемы" AI_REVIEW.md; then
  #   echo "❌ Обнаружены критические проблемы! Пуш заблокирован."
  #   echo "   Исправьте проблемы или удалите файл AI_REVIEW.md для продолжения."
  #   exit 1
  # fi
else
  echo "❌ Ошибка: отчет AI_REVIEW.md не был создан"
  # Не блокируем пуш в случае ошибки скрипта
fi

echo "✅ AI-ревью завершено. Продолжение пуша..."