{
  "name": "conscious",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "npm": "please-use-yarn",
    "yarn": ">= 1.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "env:init": "node scripts/env-init.js",
    "env:check": "node scripts/env-check.js",
    "env:validate": "node scripts/env-validate.js",
    "lint": "eslint . --ext .js,.vue",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prettier:fix-all": "prettier --write . --ignore-path .prettierignore",
    "prettier:fix-changes": "pretty-quick --ignore-path .prettierignore",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "yarn build && gh-pages -d dist",
    "prepare": "husky",
    "lint:staged": "lint-staged",
    "ai-review": "node scripts/ai-review.js"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "gh-pages": "5.0.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-vue": "^9.30.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "^3.0.0",
    "pretty-quick": "4.2.2",
    "sass": "^1.80.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-vuetify": "^2.0.0",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.0.0",
    "zod": "^4.3.6"
  }
}
